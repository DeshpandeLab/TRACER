#!/bin/bash
#$ -S /bin/bash
#$ -N tracer_gbm_compare
#$ -cwd
#$ -j y
#$ -o logs/$JOB_NAME.$JOB_ID.log
#$ -pe smp 4
#$ -l h_rt=24:00:00
#$ -l h_vmem=128G

set -euo pipefail

REPO=/mnt/storage/dept/medonc/beroukhim/youyun/BTC_GBM/code/TRACER-deshpande
SIF=$REPO/tracer_deshpande_gbm.sif
MANIFEST=$REPO/tutorials/gbm/output/slide3_pieces/piece_run_manifest.csv
NPMI=$REPO/tutorials/gbm/data/gbm_npmi.csv
MERGED=$REPO/tutorials/gbm/output/slide3_tracer_merged.parquet
OUTDIR=$REPO/tutorials/gbm/output/slide3_profile_comparison
ANNOTATIONS=/mnt/storage/dept/medonc/beroukhim/youyun/BTC_GBM/data/xenium/Xenium_Annotations/adata_obs_annotated.csv

if [[ ! -f "$SIF" ]]; then
    echo "Missing Apptainer container: $SIF" >&2
    exit 1
fi
if [[ ! -f "$MANIFEST" ]]; then
    echo "Missing piece run manifest: $MANIFEST" >&2
    exit 1
fi
if [[ ! -f "$NPMI" ]]; then
    echo "Missing NPMI file: $NPMI" >&2
    exit 1
fi

mkdir -p "$REPO/logs" "$OUTDIR"

source /mnt/storage/dept/medonc/beroukhim/youyun/util/miniforge3/etc/profile.d/conda.sh
conda activate segmentation

export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=${NSLOTS:-4}
export OPENBLAS_NUM_THREADS=${NSLOTS:-4}
export MKL_NUM_THREADS=${NSLOTS:-4}
export NUMEXPR_NUM_THREADS=${NSLOTS:-4}

cd "$REPO"

echo "=== Step 1: Merging 8 TRACER piece parquets ==="
apptainer exec \
    --bind /mnt/storage:/mnt/storage \
    --bind "$REPO/tutorials":/app/tutorials \
    --pwd /app \
    "$SIF" \
    python /app/tutorials/gbm/merge_slide3_tracer.py \
        --manifest "$MANIFEST" \
        --tracer-dir "$REPO/tutorials/gbm/output/slide3_tracer" \
        --output "$MERGED"

echo "=== Step 2: Comparing original vs TRACER-refined profiles ==="
apptainer exec \
    --bind /mnt/storage:/mnt/storage \
    --bind "$REPO/tutorials":/app/tutorials \
    --pwd /app \
    "$SIF" \
    python /app/tutorials/gbm/compare_profiles.py \
        --input "$MERGED" \
        --npmi "$NPMI" \
        --outdir "$OUTDIR" \
        --annotations-csv "$ANNOTATIONS"

echo "=== Done. Outputs written to $OUTDIR ==="
